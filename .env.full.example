# Full environment contract -- EVERY variable both services read, with
# defaults and rationale. For a quick start use the minimal .env.example;
# any variable added to the code MUST land here in the same change.

# Application
APP_NAME=litestar-base
APP_ENV=dev

# ASGI server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=2
# Seconds uvicorn waits for inflight requests on SIGTERM before forcing close.
# Must be < orchestrator hard timeout (K8s default 30s) so the lifespan stop
# (worker drain, event-bus flush) gets to run before SIGKILL.
APP_SHUTDOWN_TIMEOUT_S=25

# Paths
# Persistent application data, sibling of src/. Logs live under ${VOLUME_PATH}/logs.
VOLUME_PATH=./storage

# Process runtime files such as pidfiles. Defaults to /tmp/${APP_NAME}.
# RUNTIME_PATH=/tmp/litestar-base

# Logging (admin/log subsystem) — file-tail viewer. Owned by AdminLogConfig.
# Read by: src/litestar_backend/src/admin/log/config.py
# Path to the rotating JSONL file the admin UI reads (history + live tail).
# Must be on a writable volume; rotated externally (logrotate / docker).
#LOG_FILE_PATH=./storage/logs/app.jsonl
# Lines returned by the initial tail render.
#LOG_TAIL_LINES=200
# Lines pulled per "load more" (reads deeper into the file).
#LOG_LOAD_MORE_LINES=200
# Poll cadence for the live SSE follow loop, milliseconds.
#LOG_FOLLOW_POLL_MS=250
# Per-line byte cap; over-long lines are skipped on the read side.
#LOG_MAX_LINE_BYTES=65536

# Snitchbot — Telegram crash and anomaly reporter.
# Disabled by default so a fresh checkout starts without Telegram credentials.
# To enable: comment out SNITCHBOT_DISABLED and fill TOKEN + CHAT_ID.
SNITCHBOT_DISABLED=1
#SNITCHBOT_TOKEN=
#SNITCHBOT_CHAT_ID=


# ─── Security headers ────────────────────────────────────────────────────────
# Content-Security-Policy attached to every HTTP response. Override to tighten
# (e.g., remove 'unsafe-inline' once inline styles are gone) or to whitelist
# additional CDNs/origins for your front-end.
#SECURITY_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
# DEV-ONLY variant: the bundled Swagger/Scalar UI (/schema/swagger) loads
# assets from cdn.jsdelivr.net + an inline bootstrap script, which the strict
# default above blocks (blank page). Uncomment to render the UI locally. Keep
# the strict default in prod (self-host assets or use /schema/openapi.json).
#SECURITY_CSP=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
# Strict-Transport-Security toggle (max-age=2y, includeSubDomains). Off by
# default — enabling on http://localhost poisons the browser cache.
#SECURITY_HSTS_ENABLED=0

# CSRF signing secret for the /admin/* browser forms. REQUIRED in prod
# (multi-worker: every worker must sign with the same secret).
#   openssl rand -hex 32
#CSRF_SECRET=

# Per-client requests/minute on POST /auth/login, /auth/register,
# /auth/refresh, /admin/login, /videos. Counted in Valkey, holds across
# workers. Keyed on the direct client address: behind a reverse proxy
# configure real-IP forwarding (proxy protocol / uvicorn --proxy-headers),
# or every client collapses into the proxy's single bucket.
#RATE_LIMIT_PER_MINUTE=20

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Bearer token granting Role.ADMIN. Empty value disables auth in dev (warning
# logged at startup). Required when APP_ENV=prod (validated by RootConfig).
# Generate one with:  openssl rand -hex 32
AUTH_ADMIN_TOKEN=

# JWT (optional). Unset -> /auth/* issuance returns 503; the static admin token
# above still works. Generate the secret with:  openssl rand -hex 32
#AUTH_JWT_SECRET=
#AUTH_JWT_ISSUER=litestar-base
#AUTH_JWT_ACCESS_TTL_SECONDS=900
#AUTH_JWT_REFRESH_TTL_SECONDS=1209600
# Postgres schema owned by the auth context (users, api_keys, outbox tables).
#AUTH_SCHEMA_NAME=auth
# SQLAlchemy pool size for the auth engine.
#AUTH_POOL_SIZE=5

# ─── Build info ───────────────────────────────────────────────────────────────
# Reported via /health and admin dashboard. Populated by CI/Docker build:
#   GIT_COMMIT_SHA=$(git rev-parse HEAD)
#   GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
#   GIT_DIRTY=$([ -n "$(git status --porcelain)" ] && echo 1 || echo 0)
# In dev with a checked-out repo these are auto-resolved via `git` subprocess —
# no need to set them. In Docker without git installed: env vars are required,
# otherwise commit_sha falls back to "unknown".
#GIT_COMMIT_SHA=
#GIT_BRANCH=
#GIT_DIRTY=0

# PostgreSQL (shared by media_example and db_example_litestar; schema-per-context)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=litestar_base

# db_example_litestar (SQLAlchemy + advanced-alchemy) -- schema
DB_EXAMPLE_LITESTAR_SCHEMA_NAME=db_example_litestar

# ─── media_example (video ingest pipeline) ───────────────────────────────────
# Read by: src/litestar_backend/src/media_example/config.py
# Postgres schema owned by the media_example context.
#MEDIA_SCHEMA_NAME=media
# SQLAlchemy engine pool size for the media engine.
#MEDIA_POOL_SIZE=4
# Outbox rows drained per relay cycle (SELECT ... FOR UPDATE SKIP LOCKED batch).
#MEDIA_RELAY_BATCH=100
# Seconds the relay sleeps when the outbox is empty.
#MEDIA_RELAY_IDLE_SLEEP=0.5
# Entries per XREADGROUP read on the video_status consumer.
#MEDIA_STATUS_BATCH=100
# XREADGROUP blocking timeout, milliseconds.
#MEDIA_STATUS_BLOCK_MS=1000
# Idle threshold (ms) before an unacked video_status entry is XAUTOCLAIMed.
#MEDIA_STATUS_CLAIM_IDLE_MS=60000
# Max concurrent SSE subscribers on /videos/feed per worker process; excess
# connections get 503 instead of exhausting the event loop.
#MEDIA_FEED_MAX_CONNECTIONS=100
# Seconds of silence before the feed emits an SSE keep-alive comment.
#MEDIA_FEED_HEARTBEAT_SECONDS=15.0

# ─── Metrics ──────────────────────────────────────────────────────────────────
# Read by: src/litestar_backend/src/shared/config.py (MetricsConfig)
# Prometheus multiprocess mode: shared directory for per-worker mmap metric files.
# Defaults to ${VOLUME_PATH}/prometheus. Must be writable and wiped on container
# restart (Docker tmpfs or equivalent). Set in master process BEFORE metric creation.
#METRICS_MULTIPROC_DIR=${VOLUME_PATH}/prometheus
# Prometheus /metrics endpoint path (e.g., /metrics).
#METRICS_PROM_ENDPOINT_PATH=/metrics
# When true, /metrics endpoint has no admin guard. Use only inside trusted networks.
#METRICS_PROM_ENDPOINT_PUBLIC=false

# ─── Valkey ───────────────────────────────────────────────────────────────────
# Wire-compatible Redis protocol; client library stays redis.asyncio.
# In Docker Compose the service name is "valkey"; change for external instances.
VALKEY_HOST=localhost
VALKEY_PORT=6379
#VALKEY_DB=0
#VALKEY_PASSWORD=
#VALKEY_MAX_CONNECTIONS=20

# ─── event_microservice (media_processing) ────────────────────────────────────
# Read by: src/event_microservice/src/root/config.py
# Valkey DSN for this service (compose sets redis://valkey:6379/0 directly).
#VALKEY_URL=redis://localhost:6379/0

# Read by: src/event_microservice/src/media_processing/config.py
# Max SAQ jobs processed concurrently per worker process.
#MEDIA_PROCESSING_WORKER_CONCURRENCY=10
# Thread pool size for I/O-bound job steps.
#MEDIA_PROCESSING_THREAD_POOL_SIZE=4
# Process pool size for CPU-bound job steps (transcode).
#MEDIA_PROCESSING_PROCESS_POOL_SIZE=2
# Simulated I/O latency per fake job step, seconds.
#MEDIA_PROCESSING_FAKE_WORK_SECONDS=0.05
# CPU-burn loop iterations in the fake transcode job.
#MEDIA_PROCESSING_TRANSCODE_ITERATIONS=2000000
# TTL for the per-video join state in Valkey, seconds.
#MEDIA_PROCESSING_JOIN_TTL_SECONDS=3600
# TTL for the inbox dedup keys (event_id idempotency window), seconds.
#MEDIA_PROCESSING_INBOX_TTL_SECONDS=86400
# SAQ retry attempts per job before it is marked failed.
#MEDIA_PROCESSING_JOB_RETRIES=3
# Per-job timeout, seconds.
#MEDIA_PROCESSING_JOB_TIMEOUT_SECONDS=120
# Port for the worker/consumer Prometheus HTTP server (in-container).
#MEDIA_PROCESSING_METRICS_PORT=9100

# ─── SAQ web panel (event_microservice_worker) ────────────────────────────────
# HTTP Basic auth password for the SAQ monitoring UI (host port 8081, user
# "admin"). Empty = panel served without auth; acceptable in dev only.
#SAQ_WEB_PASSWORD=
