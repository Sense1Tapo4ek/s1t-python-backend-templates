# Minimal quick-start config -- copy to .env and fill the two secrets:
#   cp .env.example .env && openssl rand -hex 32   # paste into AUTH_ADMIN_TOKEN
# Every other knob (logging, metrics, CSP, JWT TTLs, SAQ panel, build info)
# lives, documented, in .env.full.example -- the full contract. Values here
# are a strict subset of it.

# Application
APP_NAME=litestar-base
APP_ENV=dev

# Persistent app data (logs, prometheus shards), sibling of src/.
VOLUME_PATH=./storage

# Telegram crash reporter off so a fresh checkout boots without credentials.
SNITCHBOT_DISABLED=1

# Bearer token granting Role.ADMIN. Empty disables auth in dev (warning at
# startup); REQUIRED when APP_ENV=prod.  openssl rand -hex 32
AUTH_ADMIN_TOKEN=

# JWT login for registered users (/auth/register, /auth/login). Unset ->
# JWT issuance returns 503; the static admin token still works.
#AUTH_JWT_SECRET=

# PostgreSQL (schema-per-context; in Docker Compose the host is "db").
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=litestar_base

# Valkey (Redis-wire; in Docker Compose the host is "valkey").
VALKEY_HOST=localhost
VALKEY_PORT=6379

# ─── PROD checklist (all validated/needed when APP_ENV=prod) ─────────────────
# AUTH_ADMIN_TOKEN  -- required (see above)
# CSRF_SECRET       -- required; signs /admin form tokens across workers
#CSRF_SECRET=
# POSTGRES_USER/POSTGRES_PASSWORD -- change the default postgres/postgres
# credentials (and rotate them if the default ever faced a network).
# SECURITY_HSTS_ENABLED=1 behind verified HTTPS; RATE_LIMIT_PER_MINUTE to
# taste. Details in .env.full.example.
